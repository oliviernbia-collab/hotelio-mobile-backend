PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Base de données MySQL (même que Laravel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_hotelio
DB_USER=root
DB_PASSWORD=

# URL publique du backend mobile (utilisée pour construire les URLs des images)
APP_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Upload
UPLOAD_PATH=src/uploads
MAX_FILE_SIZE=5242880

# Jèko (agrégateur de paiement — business.jeko.africa)
JEKO_STORE_ID=
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_WEBHOOK_SECRET=

# Backend web (Laravel) — voir webPHP/.env.example, JEKO_INTERNAL_SYNC_KEY doit être identique des deux côtés.
WEBPHP_URL=http://localhost:8080
JEKO_INTERNAL_SYNC_KEY=
