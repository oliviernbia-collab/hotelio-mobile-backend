# ══════════════════════════════════════════════════════════════
#  API mobile Hôtelio — production sur LWS (cPanel → Setup Node.js App)
#  Copier en ~/hotelio-api/.env et remplir les valeurs A_REMPLIR.
#  PORT est ignoré : Passenger (cPanel) attribue le port lui-même.
# ══════════════════════════════════════════════════════════════
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Même base MySQL que le site Laravel
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=A_REMPLIR
DB_USER=A_REMPLIR
DB_PASSWORD=A_REMPLIR

# URL publique de cette API (images, retours de paiement Jèko /payment/bridge)
APP_URL=https://api.A_REMPLIR
# Origines web autorisées (l'app native n'est pas concernée par CORS)
ALLOWED_ORIGINS=https://A_REMPLIR

# Images enregistrées par Laravel (storage/app/public du site déployé)
WEBPHP_STORAGE_PATH=/home/A_REMPLIR/hotelio/storage/app/public

# JWT — chaîne aléatoire longue, différente de celle de développement
JWT_SECRET=A_REMPLIR
JWT_EXPIRES_IN=7d

UPLOAD_PATH=src/uploads
MAX_FILE_SIZE=5242880

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Jèko — clés de PRODUCTION
JEKO_STORE_ID=
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_WEBHOOK_SECRET=

# Site Laravel — JEKO_INTERNAL_SYNC_KEY identique à celle de webPHP/.env
WEBPHP_URL=https://A_REMPLIR
JEKO_INTERNAL_SYNC_KEY=

# E-mails de confirmation de réservation (même compte SMTP que le backend web)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Hôtelio"
